{
    "name": "@clarion-app/llm-client-frontend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "rm -rf dist; tsc",
        "lint": "eslint ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/clarion-app/llm-client-frontend.git"
    },
    "author": "Tim Schwartz <tim@metaverse.systems>",
    "license": "MIT",
    "dependencies": {
        "@clarion-app/frontend-base": "^1.0.0",
        "@clarion-app/types": "^2.0.0",
        "@reduxjs/toolkit": "^2.2.6",
        "dompurify": "^3.3.3",
        "markdown-to-jsx": "^7.7.6",
        "prismjs": "^1.30.0",
        "react": "^18.3.1",
        "react-redux": "^9.1.2",
        "react-router-dom": "^6.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^14.3.1",
        "@types/dompurify": "^3.0.5",
        "@types/prismjs": "^1.26.5",
        "@types/react": "^18.3.2",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "jsdom": "^29.0.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.2"
    },
    "customFields": {
        "clarion": {
            "api": [
                "llmClientConversationApi",
                "llmClientMessageApi",
                "llmClientModelApi",
                "llmClientServerApi",
                "llmClientRoleAssignmentApi",
                "llmClientServerStatusApi",
                "llmClientRunApi",
                "llmClientEvalDashboardApi",
                "llmClientAgentBrowserApi",
                "llmClientAgentShareApi",
                "llmClientAgentHelperApi",
                "llmClientDelegationApi"
            ],
            "routes": [
                {
                    "path": "/clarion-app/llm-client/conversations",
                    "element": "<Conversations />"
                },
                {
                    "path": "/clarion-app/llm-client/conversations/:id",
                    "element": "<Conversation />"
                },
                {
                    "path": "/clarion-app/llm-client/model-setup",
                    "element": "<ModelSetup />"
                },
                {
                    "path": "/clarion-app/llm-client/servers",
                    "element": "<ModelSetupRedirect />"
                },
                {
                    "path": "/clarion-app/llm-client/servers/:id/models",
                    "element": "<ModelSetupRedirect />"
                },
                {
                    "path": "/clarion-app/llm-client/models",
                    "element": "<ModelSetupRedirect />"
                },
                {
                    "path": "/clarion-app/llm-client/settings",
                    "element": "<ModelSetupRedirect />"
                },
                {
                    "path": "/clarion-app/llm-client/runs",
                    "element": "<RunsList />"
                },
                {
                    "path": "/clarion-app/llm-client/runs/:id",
                    "element": "<RunDiagram />"
                },
                {
                    "path": "/clarion-app/llm-client/runs/:id/arrangement",
                    "element": "<RunArrangement />"
                },
                {
                    "path": "/clarion-app/llm-client/eval-dashboard/:agentLabel",
                    "element": "<EvalDashboard />"
                },
                {
                    "path": "/clarion-app/llm-client/eval-runs/:runId",
                    "element": "<EvalRunBreakdown />"
                },
                {
                    "path": "/clarion-app/llm-client/eval-runs/:runId/cases/:caseResultId",
                    "element": "<EvalCaseDetail />"
                },
                {
                    "path": "/clarion-app/llm-client/agents",
                    "element": "<AgentBrowser />"
                }
            ],
            "menu": {
                "name": "LLM CLient",
                "entries": [
                    {
                        "name": "Conversations",
                        "path": "/clarion-app/llm-client/conversations"
                    },
                    {
                        "name": "Model Setup",
                        "path": "/clarion-app/llm-client/model-setup"
                    },
                    {
                        "name": "Runs",
                        "path": "/clarion-app/llm-client/runs"
                    },
                    {
                        "name": "Agents",
                        "path": "/clarion-app/llm-client/agents"
                    }
                ],
                "pinnedEntries": [
                    "Conversations"
                ]
            }
        }
    }
}
