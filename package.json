{
    "name": "@clarion-app/llm-client-frontend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "rm -rf dist; tsc"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/clarion-app/llm-client-frontend.git"
    },
    "author": "Tim Schwartz <tim@metaverse.systems>",
    "license": "MIT",
    "dependencies": {
        "@clarion-app/types": "^1.4.0",
        "@reduxjs/toolkit": "^2.2.6",
        "markdown-to-jsx": "^7.7.6",
        "prismjs": "^1.30.0",
        "react": "^18.3.1",
        "react-redux": "^9.1.2",
        "react-router-dom": "^6.24.1",
        "typescript": "^5.4.5"
    },
    "devDependencies": {
        "@types/prismjs": "^1.26.5",
        "@types/react": "^18.3.2"
    },
    "customFields": {
        "clarion": {
            "api": [
                "llmClientConversationApi",
                "llmClientMessageApi",
                "llmClientModelApi",
                "llmClientServerApi"
            ],
            "routes": [
                {
                    "path": "/clarion-app/llm-client/conversations",
                    "element": "<Conversations />"
                },
                {
                    "path": "/clarion-app/llm-client/conversations/:id",
                    "element": "<Conversation />"
                },
                {
                    "path": "/clarion-app/llm-client/servers",
                    "element": "<Servers />"
                },
                {
                    "path": "/clarion-app/llm-client/servers/:id/models",
                    "element": "<Models />"
                },
                {
                    "path": "/clarion-app/llm-client/models",
                    "element": "<AllModels />"
                }
            ],
            "menu": {
                "name": "LLM CLient",
                "entries": [
                    {
                        "name": "Conversations",
                        "path": "/clarion-app/llm-client/conversations"
                    },
                    {
                        "name": "Servers",
                        "path": "/clarion-app/llm-client/servers"
                    },
                    {
                        "name": "Models",
                        "path": "/clarion-app/llm-client/models"
                    }
                ],
                "pinnedEntries": ["Conversations"]
            }
        }
    }
}
